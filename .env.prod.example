# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=bakala
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Application ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://bakala:CHANGE_ME_strong_password_here@postgres:5432/bakala
REDIS_URL=redis://:CHANGE_ME_redis_password_here@redis:6379
REDIS_PASSWORD=CHANGE_ME_redis_password_here
ELASTICSEARCH_URL=http://elasticsearch:9200

# Public URL of your domain (no trailing slash) — used for CORS
FRONTEND_URL=https://yourdomain.com

# Minimum 32 random chars — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_64_char_minimum_secret

PORT=3000
TRACKING_PORT=3001
DISCOVERY_PORT=3002
NODE_ENV=production

# ── Stripe ────────────────────────────────────────────────────────────────────
# Live secret key from the Stripe dashboard — never expose this to the frontend
STRIPE_SECRET_KEY=CHANGE_ME_sk_live_...
# Signing secret for the webhook endpoint (Developers → Webhooks → your endpoint)
STRIPE_WEBHOOK_SECRET=CHANGE_ME_whsec_...
# One shared Product used for all vendor subscription plans (dashboard-set price per store)
STRIPE_PRODUCT_ID=CHANGE_ME_prod_...
# Publishable key — safe to expose, but still baked into the frontend build via this var
VITE_STRIPE_PUBLISHABLE_KEY=CHANGE_ME_pk_live_...
